# Home Assistant URL (ohne Slash am Ende) und Long-Lived Access Token.
# Token erstellen: HA -> Profil -> Sicherheit -> Langlebige Zugangstoken.
# Leer lassen (oder Datei weglassen) = Demo-Modus mit simulierten Geräten.
# 'auto' = gleicher Host wie das Dashboard, Port 8123 (empfohlen für Pi + Browser im LAN).
VITE_HA_URL=auto
VITE_HA_TOKEN=
